# 复制成 .env 后填入真实值：Windows 用 copy .env.example .env
# 这个文件可以提交；.env 绝对不要提交。

# Xiaomi MiMo 平台 https://platform.xiaomimimo.com/#/console/api-keys
# 按量付费 Key 形如 sk-xxxxx；Token Plan Key 形如 tp-xxxxx
MIMO_API_KEY=
# 若已订阅 Token Plan，改成 https://token-plan-cn.xiaomimimo.com/v1
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# DeepSeek 平台 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
